{
  "name": "helpdesk-ticket-api",
  "version": "1.0.0",
  "description": "REST API for an IT helpdesk: raise, assign and resolve tickets, with SLA tracking.",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env --test",
    "test:db": "node --env-file=.env --test test/repository.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.0"
  },
  "license": "MIT"
}
